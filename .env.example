# Plantilla de configuracion local de Bones & Paws.
#
# NO edites este archivo: es el ejemplo que se comparte con el proyecto.
# Ejecuta "python instalar.py" y el te crea tu propio ".env" con estos
# valores y una SECRET_KEY aleatoria. (O copialo a mano a ".env".)
#
# El ".env" real nunca se comparte: lleva la contrasena de MySQL, que
# cambia en cada equipo.

# Clave de firma de las sesiones de Flask. Debe ser larga y aleatoria.
# Genera una nueva con:  python instalar.py --regenerar-clave
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-y-larga

# Conexion a MySQL / MariaDB.
# Valores tipicos de XAMPP: host localhost, puerto 3306, usuario root,
# contrasena vacia.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bandp

# Servidor de desarrollo
FLASK_DEBUG=True
FLASK_PORT=5000

# ------------------------------------------------------------------
# Correo saliente — recuperacion de contrasena
# ------------------------------------------------------------------
# Cuenta de Gmail que envia el codigo de verificacion.
#
# MAIL_CONTRASENA NO es la contrasena del correo: es una "contrasena de
# aplicacion" de 16 letras. Para generarla:
#   1. Activa la verificacion en dos pasos de la cuenta de Google
#      -> https://myaccount.google.com/security
#   2. Entra a https://myaccount.google.com/apppasswords
#   3. Crea una para "Bones & Paws" y copia aqui las 16 letras (sin espacios)
#
# Si dejas MAIL_USUARIO vacio, la app no se rompe: con FLASK_DEBUG=True el
# correo y el codigo se imprimen en la consola de Flask.
MAIL_SERVIDOR=smtp.gmail.com
MAIL_PUERTO=587
MAIL_USAR_TLS=True
MAIL_USAR_SSL=False
MAIL_USUARIO=
MAIL_CONTRASENA=
MAIL_NOMBRE_REMITENTE=Bones & Paws

# Que hacer si MAIL_USUARIO esta vacio:
#   True  -> el correo (con el codigo) se imprime en la consola de Flask y
#            el flujo sigue: sirve para demostrar la recuperacion sin
#            configurar credenciales.
#   False -> se responde con un error en vez de fingir que salio.
# Si no se pone, sigue el valor de FLASK_DEBUG.
MAIL_A_CONSOLA=True
